#!/usr/bin/env bash
set -euo pipefail

SESSION_ID="${XDG_SESSION_ID:?}"
SCREENSHOT="$HOME/Pictures/Screenshots/latest.png"
# Check LockedHint
is_locked() {
    [[ $(loginctl show-session "$SESSION_ID" -p LockedHint --value) == "yes" ]]
}

take_screenshot() {
    if is_locked; then
        echo "$0(${SESSION_ID}): Skip, already locked (LockedHint=yes)"
        return 0
    fi

    rm -f "$SCREENSHOT"
    niri msg action screenshot-screen --path "$SCREENSHOT"
    ret=$?
    if [[ $ret -eq 0 ]]; then
        echo "$0(${SESSION_ID}): Screenshot successful"
    fi
}

remove_screenshot() {
    rm -f "$SCREENSHOT"
    # There is NOTHING left to do
}

case "$1" in
    LOCK)
        take_screenshot &
        ;;
    UNLOCK)
        remove_screenshot &
        ;;
    SLEEP)
        take_screenshot &
        ;;
    RESUME)
        remove_screenshot &
        ;;
    *)
        ;;
esac
